    "name": "h1.f21h@text##作者[:：][\\s\\S]*##",
    "author": "h1.f21h em a@text",
    "intro": ".intro@text##^[\\s]*关于[\\s\\S]*?：##",
    "coverUrl": "div.pic img@src",
    "lastChapter": "div.txt em a@text",
    "tocUrl": "span.btopt a@href"
  },
  "ruleToc": {
    "chapterList": "#list dd a[209:]",
    "chapterName": "@text",
    "chapterUrl": "@href"
  },
